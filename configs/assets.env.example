# Copy to a private file and fill in paths you are licensed to use.
# Do not commit the filled file.

# Join package root. Commands that use relative data/ and third_party/
# paths expect to be run from this directory, or with these links in place.
ISR_JOIN_ROOT=join

# Unitree G1 description directory (contains g1_29dof_rev_1_0.urdf, .xml, meshes/).
# Not bundled. Clone the upstream description that matches g1_29dof_rev_1_0
# and keep its LICENSE file beside the meshes.
UNITREE_G1_ROOT=

# CORE4D motions and object meshes, after you accept the dataset license.
# Expected layout: $ISR_CORE4D_DATA/motions and $ISR_CORE4D_DATA/object_models
# Place or symlink that tree at join/data/core4d
ISR_CORE4D_DATA=

# Optional private bundle of frozen Join trajectories (not in this repository).
# Point this at a read-only copy of the v41 / EXT-JC result directories.
ISR_JOIN_PRIVATE_ROOT=

# Soccer Level 4 only. The human source video is not in this repository.
SOCCER_SOURCE_VIDEO=

# Official GVHMR checkout and its separately licensed weights. Not bundled.
GVHMR_ROOT=
YOLO_WEIGHTS=

# Directory of the two GVHMR result files, if you rerun preprocessing.
SOCCER_GVHMR_RESULTS=

# Set to 1 only in a disposable copy. The bundled Soccer results refuse writes.
# ISR_ALLOW_FROZEN_OVERWRITE=0
